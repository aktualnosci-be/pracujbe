# =========================================================================
# Pracuj.be — przykładowe zmienne środowiskowe.
# Skopiuj do .env.local i uzupełnij. NIE commituj .env.local.
# Zmienne NEXT_PUBLIC_* trafiają do przeglądarki — nie umieszczaj tam sekretów.
# =========================================================================

# --- Aplikacja ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # w produkcji: https://pracuj.be
NEXT_PUBLIC_DEFAULT_LOCALE="pl"
# Tryb aplikacji: production także na stagingu z prawdziwą bazą; demo tylko świadomie lokalnie.
# APP_MODE jest jedynym źródłem trybu, niezależnie od hostingu. Produkcja bez konfiguracji =503.
APP_MODE=""
# Wydanie 1.0.0 tylko jawnie (docs/RELEASE_1_0.md, #103); inna niepusta wartość przerywa build.
# PRACUJBE_RELEASE_VERSION=""

# Bramka „w przygotowaniu”: gdy ustawione, każda strona wymaga tego hasła (cookie na 30 dni).
# Tylko serwer — nigdy NEXT_PUBLIC_*. Usuń zmienną, aby otworzyć serwis publicznie.
SITE_ACCESS_PASSWORD=""

# Jedyny zaufany nagłówek proxy dla adresu IP klienta (receipt zgody, aplikacja bez konta,
# limiter — #588/#602). Domyślnie "x-real-ip" (brzeg Railway); "cf-connecting-ip", gdy przed
# Railway stoi Cloudflare proxying ruch. X-Forwarded-For NIGDY nie jest źródłem (klient go dopisuje).
# TRUSTED_PROXY_HEADER="x-real-ip"

# --- PostgreSQL Railway: konta, sesje i dane (#24, #429) — tylko serwer, nigdy NEXT_PUBLIC_* ---
# W APP_MODE=production wymagane: DATABASE_APP_URL, DATABASE_AUTH_URL, BETTER_AUTH_URL,
# BETTER_AUTH_SECRET, DATABASE_RATE_LIMIT_URL, RATE_LIMIT_KEY_SECRET i DATABASE_SERVICE_URL — bez nich
# /api/health = 503.
# Każdy URL to osobny login NOINHERIT z członkostwem w JEDNEJ roli (docs/railway/LOGINY_POSTGRESQL_ONE_OFF.md).
# Pula domeny (rola pracujbe_app): profile, dane portalu, odczyt tożsamości sesji.
DATABASE_APP_URL=""
# Zadania uprzywilejowane (#25, rola service_role): worker poczty, webhooki, cron maintenance,
# odczyty panelu admina. Nigdy URL migratora ani loginu WWW; loadery paneli używają DATABASE_APP_URL.
DATABASE_SERVICE_URL=""
# Better Auth (rola pracujbe_auth): konta, poświadczenia, sesje.
DATABASE_AUTH_URL=""
# Kanoniczny origin HTTPS = NEXT_PUBLIC_SITE_URL (np. https://pracuj.be), bez ścieżki i query.
BETTER_AUTH_URL=""
# Losowy sekret co najmniej 32 znaki; niezależny od sekretów kolejki i health checku.
BETTER_AUTH_SECRET=""
# Limiter prób logowania/rejestracji/resetu (rola pracujbe_rate_limit, 0058).
DATABASE_RATE_LIMIT_URL=""
# Sekret HMAC kluczy limitera, min. 32 znaki (do bazy nie trafia surowy IP ani e-mail).
RATE_LIMIT_KEY_SECRET=""
# Worker wiadomości kont — potwierdzenie adresu i reset hasła (rola pracujbe_auth_mail, 0061).
# Obsługuje go cron /api/email/process (EMAIL_QUEUE_SECRET) przez dostawcę z EMAIL_PROVIDER.
DATABASE_AUTH_MAIL_URL=""

# --- Prywatne pliki kandydata (CV) — bucket Railway (#26, Invariant #10) ---
# Nazwy = preset „AWS SDK” w zakładce Credentials bucketu Railway (referencje zmiennych).
# Tylko serwer — nigdy NEXT_PUBLIC_*. Bucket jest prywatny; pobranie wyłącznie przez podpisany,
# krótki link aplikacji (/api/files/cv/<id>) z ponowną kontrolą sesji i właściciela.
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# virtual (domyślnie) albo path — zgodnie z informacją w Credentials bucketu.
AWS_S3_URL_STYLE=
# Podpis HMAC linków pobrania CV (TTL 60 s), losowy, min. 32 znaki. Niezależny od innych sekretów.
FILE_DOWNLOAD_SECRET=
# GC bucketu CV (#17, /api/maintenance): puste/inne = dry-run (same liczniki); `delete` = sieroty
# bez wiersza files trafiają do kolejki usuwania. Kasowanie na produkcji po zatwierdzeniu właściciela.
STORAGE_GC_MODE=

# --- Dostawca poczty: emaillabs | resend (patrz docs/EMAILLABS_SETUP.md) ---
# Pusty = EmailLabs, gdy są trzy klucze EMAILLABS_*, inaczej Resend przy RESEND_API_KEY.
# Jawna wartość bez kluczy wybranego dostawcy = brak wysyłki (bez cichego przełączenia).
EMAIL_PROVIDER=""

# --- EmailLabs (e-maile transakcyjne, patrz docs/EMAILLABS_SETUP.md) ---
# Panel: Konto → Ustawienia → API → „Application-Key” i „Authorization” (128 znaków).
EMAILLABS_APP_KEY=""
EMAILLABS_SECRET_KEY=""
# Nazwa konta SMTP z panelu, np. 1.pracujbe.smtp
EMAILLABS_SMTP_ACCOUNT=""
# SecretKey webhooka (Konto → Ustawienia → Webhooki → „Generuj SecretKey”) dla
# /api/email/webhook/emaillabs. Brak = endpoint odpowiada 503 (fail-closed).
EMAILLABS_WEBHOOK_SECRET=""
# Opcjonalnie Basic auth webhooka (ustaw oba albo żadnego; wtedy wymagany obok SecretKey).
EMAILLABS_WEBHOOK_BASIC_USER=""
EMAILLABS_WEBHOOK_BASIC_PASSWORD=""

# --- Resend (alternatywny dostawca, patrz docs/RESEND_SETUP.md) ---
# Puste = brak wysyłki przez Resend (worker pomija kolejkę, /api/health zgłasza brak
# konfiguracji, #587). Wpisz prawdziwy klucz z panelu Resend — sam skopiowany plik nie
# daje fałszywej gotowości.
RESEND_API_KEY=""
EMAIL_FROM="Pracuj.be <no-reply@pracuj.be>"
EMAIL_REPLY_TO="kontakt@pracuj.be"
# Tożsamość nadawcy w stopce (#45). Wymagana (razem z jawnym EMAIL_FROM) do wysyłki
# newslettera; bez niej wiadomości marketingowe nie wychodzą. Wpisz dane prawdziwego podmiotu.
EMAIL_SENDER_IDENTITY=""
EMAIL_SENDER_POSTAL_ADDRESS=""

# --- Kanał błędów (#571, zamiast Sentry) ---
# Webhook Discorda — TYLKO serwer (bez NEXT_PUBLIC_). Postać natywna
# https://discord.com/api/webhooks/<id>/<token> albo zgodna ze Slackiem (ten sam adres + /slack).
# Pusta = brak wysyłki (/api/health: checks.errorWebhook=false). Wysyłany jest tylko kod błędu,
# trasa bez query, wydanie, środowisko i czas. Patrz docs/TELEMETRY_PRIVACY.md.
ERROR_WEBHOOK_URL=""

# --- Kolejka e-mail / zadania serwerowe ---
# Sekret chroniący route handler przetwarzający kolejkę (cron/worker).
EMAIL_QUEUE_SECRET=""
# Podpis HMAC linków wypisania z e-maili (#45), min. 32 znaki. Zmiana unieważnia wysłane linki.
EMAIL_UNSUBSCRIBE_SECRET=""
# Signing secret webhooka doręczeń Resend (#44, `whsec_...`) dla /api/email/webhook/resend.
# Brak = endpoint odpowiada 503 (fail-closed). Patrz docs/RESEND_SETUP.md §6.
RESEND_WEBHOOK_SECRET=""
# Sekret /api/maintenance (#13) — INNY niż EMAIL_QUEUE_SECRET (ta sama wartość = 401 dla obu).
MAINTENANCE_SECRET=""
# Przejściowy sekret harmonogramu vercel.json (otwiera oba zadania); usuń po uruchomieniu cronów
# Railway, przywróć przy rollbacku. Patrz docs/railway/README.md („Cron”).
CRON_SECRET=""
# Czyszczenie spraw DSA w /api/maintenance (#43): domyślnie wyłączone — terminy czekają na
# decyzję właściciela (#40). Tylko dokładnie `dry-run` (podgląd + liczniki) albo `apply`.
DSA_RETENTION_MODE=""
# Retencja danych w /api/maintenance (#574, okresy z 0127): domyślnie wyłączona — harmonogram
# włącza właściciel po akceptacji testów i danych operatora. Tylko dokładnie `dry-run`
# (liczniki jednej partii bez zmian) albo `apply` (usuwanie i ostrzeżenia).
RETENTION_MODE=""
# Aplikacja bez konta (#98): podpis HMAC tokenów w linkach e-mail (w bazie tylko hash).
# Min. 32 znaki; wymagany w produkcji (bez niego formularz gościa jest wyłączony).
# Zmiana unieważnia wysłane linki. Patrz docs/GUEST_APPLY.md.
GUEST_APPLY_SECRET=""
HEALTH_CHECK_SECRET=""        # nagłówek x-health-token: szczegóły /api/health i czujki /api/health/ops (#47)
# Login monitoringu PostgreSQL: członkostwo WYŁĄCZNIE w pracujbe_ops (0096) — docs/railway/OPERATIONS.md.
DATABASE_OPS_URL=""
# Kopia bazy w prywatnym buckecie Cloudflare R2 (#569) — OSOBNY bucket, nie AWS_* plików CV.
# Usługa web: tylko klucz ODCZYTU (czujka wieku kopii w /api/health/ops; brak = backup_unconfigured).
BACKUP_S3_ENDPOINT=""                 # https://<konto>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX=""                   # opcjonalnie, np. pracujbe/
BACKUP_S3_REGION=""                   # domyślnie auto
BACKUP_S3_READ_ACCESS_KEY_ID=""
BACKUP_S3_READ_SECRET_ACCESS_KEY=""
# Tylko usługa `backup` (docker/backup/Dockerfile) — NIE ustawiaj w usłudze web (alarm backup_misconfigured):
# BACKUP_S3_ACCESS_KEY_ID=""
# BACKUP_S3_SECRET_ACCESS_KEY=""
# BACKUP_S3_MAX_AGE_DAYS=""
# BACKUP_SOURCE_URL=""
# BACKUP_AGE_RECIPIENTS=""
# Osobne usługi cron otrzymują tylko adres prywatnego endpointu i jego właściwy sekret.
CRON_TARGET_URL=""
CRON_AUTH_SECRET=""

# --- Płatności: WYŁĄCZONE w bezpłatnym MVP (#51, docs/PRODUCT_DECISIONS.md) ---
# Jedna jawna flaga sprzedaży. Domyślnie wyłączona; włącza ją wyłącznie dokładne "true".
# Nie ustawiaj jej w produkcji: bez nowej decyzji właściciela sprzedaż nie wraca. Nawet z flagą
# ta wersja nie ma checkoutu (akcje → BILLING_UNAVAILABLE, webhook → 410).
BILLING_ENABLED=""
# Sekrety Stripe bez BILLING_ENABLED są ignorowane (nie konfigurują klienta ani gotowości).
STRIPE_SECRET_KEY=""          # sk_live_... / sk_test_...; tylko serwer, nigdy NEXT_PUBLIC_*
# Sekret webhooka Stripe (Dashboard → Developers → Webhooks; endpoint /api/stripe/webhook).
# Webhook jest ŹRÓDŁEM PRAWDY o subskrypcji/fakturach/płatnościach. Zdarzenia: checkout.session.
# completed, customer.subscription.*, invoice.paid, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=""      # whsec_...; tylko serwer
# --- Dostawca AI: wyłącznie OpenAI (decyzja właściciela 2026-09-26, model GPT-6 Luna) ---
OPENAI_API_KEY=""             # tylko serwer, nigdy NEXT_PUBLIC_*; wspólny dla wszystkich funkcji AI
AI_MODEL=""                   # opcjonalnie; domyślny model wszystkich funkcji, domyślnie gpt-6-luna
# --- Import ogłoszenia przez AI (#465, docs/AI_JOB_IMPORT.md) — domyślnie WYŁĄCZONY ---
# Bez flagi albo bez klucza krok „Zaimportuj z ogłoszenia" jest niewidoczny.
AI_JOB_IMPORT_ENABLED=""      # 1 = włączony
AI_JOB_IMPORT_MODEL=""        # opcjonalnie; domyślnie AI_MODEL → gpt-6-luna
# AI_JOB_IMPORT_PROVIDER="fixture"  # atrapa bez sieci (E2E/lokalnie); ignorowana przy APP_MODE=production
# --- Asystent redagowania oferty (#37, docs/AI_JOB_ASSIST.md) — domyślnie WYŁĄCZONY ---
# Osobna flaga; używa tego samego OPENAI_API_KEY. Propozycje tylko do akceptacji pole po polu.
AI_JOB_ASSIST_ENABLED=""      # 1 = włączony
AI_JOB_ASSIST_MODEL=""        # opcjonalnie; domyślnie AI_MODEL → gpt-6-luna
# AI_JOB_ASSIST_PROVIDER="fixture"  # atrapa bez sieci (E2E/lokalnie); ignorowana przy APP_MODE=production
# --- Tłumaczenia AI (#31/#32, docs/AI_TRANSLATION.md) — domyślnie WYŁĄCZONE ---
# Rdzeń: kolejka w bazie (0145) + adapter + walidacja faktów. Wpięcie ofert/profili: #33/#34.
AI_TRANSLATION_ENABLED=""     # 1 = worker tłumaczeń może działać (używa OPENAI_API_KEY)
AI_TRANSLATION_MODEL=""       # opcjonalnie; domyślnie AI_MODEL → gpt-6-luna (wybór po benchmarku #30)
# AI_TRANSLATION_PROVIDER="fixture"  # atrapa bez sieci; ignorowana przy APP_MODE=production
# --- Import CV przez AI (#487, #498, docs/AI_CV_IMPORT.md) — domyślnie WYŁĄCZONY, osobna flaga ---
# Bez flagi albo bez klucza strona /candidate/profil/import-cv nie istnieje (404).
AI_CV_IMPORT_ENABLED=""       # 1 = włączony; używa tego samego OPENAI_API_KEY
AI_CV_IMPORT_MODEL=""         # opcjonalnie; domyślnie AI_MODEL → gpt-6-luna (niezależnie od AI_JOB_IMPORT_MODEL)
# AI_CV_IMPORT_PROVIDER="fixture"   # atrapa bez sieci (E2E/lokalnie); ignorowana przy APP_MODE=production

# --- Cloudflare Turnstile (ochrona formularzy publicznych, #46; patrz docs/TURNSTILE.md) ---
# Brak obu kluczy poza APP_MODE=production = widżet wyłączony (demo/E2E). W produkcji brak
# kluczy (albo tylko jeden) = rejestracja i reset hasła odrzucane, logowanie przepuszczane.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""   # publiczny klucz witryny (build-time, trafia do przeglądarki)
TURNSTILE_SECRET_KEY=""             # sekret siteverify; tylko serwer, nigdy NEXT_PUBLIC_*
# Opcjonalnie: dozwolone hostname tokenu (po przecinku). Domyślnie host NEXT_PUBLIC_SITE_URL.
TURNSTILE_ALLOWED_HOSTNAMES=""

# --- Analityka (ładowana DOPIERO po zgodzie w cookies, kategoria „analityczne") ---
# Cloudflare Web Analytics (#570, decyzja właściciela 2026-09-25: zamiast Google Analytics
# i Meta Pixel — usunięte). Bez cookies i identyfikatorów; brak tokenu = beacon się nie ładuje.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=""
# Dane polowe Core Web Vitals (LCP/INP/CLS) w /admin/wydajnosc — odczyt agregatów p75 z GraphQL
# Analytics API Cloudflare (tylko serwer). Beacon powyżej mierzy CWV sam; portal nie ma własnej
# zbiórki. Token: uprawnienie „Account Analytics: Read”, nigdy NEXT_PUBLIC_*. Brak = instrukcja.
CF_ANALYTICS_ACCOUNT_ID=""          # 32 znaki hex (identyfikator konta Cloudflare)
CF_WEB_ANALYTICS_SITE_TAG=""        # 32 znaki hex (site tag witryny w Web Analytics)
CF_ANALYTICS_API_TOKEN=""           # token API tylko do odczytu analityki konta

# --- Wersjonowanie polityki prywatności/cookies (zapisywane w consents) ---
NEXT_PUBLIC_CONSENT_POLICY_VERSION="2.0"
